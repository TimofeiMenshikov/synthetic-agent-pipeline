      "github/NexGAP/Gyrfalcon/frameworks/pitlane_proof/problem_types.json",
      "github/NexGAP/Gyrfalcon/frameworks/pitlane_proof/persona.jsonl",
      "github/NexGAP/Gyrfalcon/llm_interface/query_generator.py:QueryExporter"
